{
  "name": "bloom",
  "version": "0.1.0",
  "description": "Bloom — copiloto de café de especialidad (PWA Android)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @drift",
    "lhci": "node scripts/lhci.mjs",
    "check:hex": "node scripts/check-hex.mjs",
    "check:accent": "node scripts/check-accent.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:hex && npm run check:accent && npm run check:copy && npm run test",
    "e2e:drift": "playwright test --grep @drift"
  },
  "type": "module",
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "dexie": "4.4.7",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@serwist/turbopack": "9.5.13",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "fake-indexeddb": "6.2.7",
    "geist": "1.9.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "serwist": "9.5.13",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=20.9"
  }
}
