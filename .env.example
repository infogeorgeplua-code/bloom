# Bloom · variables de entorno (SDD §7). Copia a .env.local; nunca subas .env.local.
# Sin las de Supabase la app funciona igual, solo sin nube (fases 1–4).

# Fase 5 · públicas (cliente + servidor; RLS protege los datos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.bloomcoffe.com
# "1" muestra "Continuar con Google" (activa antes el proveedor en Supabase)
NEXT_PUBLIC_AUTH_GOOGLE=

# Fase 5 · solo CLI local (supabase link / db push). Nunca en Vercel ni en el cliente.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
