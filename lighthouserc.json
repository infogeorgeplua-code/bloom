{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3100/ds",
        "http://localhost:3100/",
        "http://localhost:3100/brew-mode/v60-base-v1"
      ],
      "startServerCommand": "npx next start -p 3100",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": [
          "accessibility"
        ],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
